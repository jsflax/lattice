diff --git a/Sources/LatticeCore/src/perf_live_profile.hpp b/Sources/LatticeCore/src/perf_live_profile.hpp
new file mode 100644
index 0000000..7a806ef
--- /dev/null
+++ b/Sources/LatticeCore/src/perf_live_profile.hpp
@@ -0,0 +1,93 @@
+#pragma once
+// Included in db.cpp only, under the diagnostic build flag. Fixed TLS storage;
+// no allocation, mutex, SQL, printing or callbacks from this instrumentation.
+#include "lattice/perf_live_profile.h"
+#include <time.h>
+#include <limits>
+#include <utility>
+
+namespace lattice_perf_detail {
+using snapshot = struct lattice_perf_live_snapshot;
+struct state {
+    snapshot totals{1, 0, 0};
+    uint64_t query_depth = 0;
+    bool span_active = false;
+};
+static thread_local state local;
+inline bool clock_ns(clockid_t clock, uint64_t& out) noexcept {
+    timespec value{};
+    if (clock_gettime(clock, &value) != 0 || value.tv_sec < 0 ||
+        value.tv_nsec < 0 || value.tv_nsec >= 1000000000 ||
+        static_cast<uint64_t>(value.tv_sec) >
+            (std::numeric_limits<uint64_t>::max() - static_cast<uint64_t>(value.tv_nsec)) / 1000000000) {
+        local.totals.faults |= 1;
+        return false;
+    }
+    out = static_cast<uint64_t>(value.tv_sec) * 1000000000 + value.tv_nsec;
+    return true;
+}
+inline void add(uint64_t& target, uint64_t value) noexcept {
+    if (value > std::numeric_limits<uint64_t>::max() - target) {
+        local.totals.faults |= 2;
+        return;
+    }
+    target += value;
+}
+struct query_scope {
+    bool active = local.totals.enabled != 0;
+    query_scope() noexcept {
+        if (active) { ++local.query_depth; add(local.totals.managed_calls, 1); }
+    }
+    ~query_scope() { if (active) --local.query_depth; }
+};
+struct span {
+    uint64_t* duration;
+    uint64_t start = 0;
+    bool active = false;
+    bool valid = false;
+    span(uint64_t& count, uint64_t& ns) noexcept : duration(&ns) {
+        if (!local.totals.enabled) return;
+        add(count, 1);
+        if (local.span_active) { local.totals.faults |= 4; return; }
+        active = local.span_active = true;
+        valid = clock_ns(CLOCK_MONOTONIC, start);
+    }
+    ~span() {
+        if (!active) return;
+        uint64_t end = 0;
+        if (clock_ns(CLOCK_MONOTONIC, end) && valid) {
+            if (end < start) local.totals.faults |= 1;
+            else add(*duration, end - start);
+        }
+        local.span_active = false;
+    }
+};
+template <typename F>
+decltype(auto) timed(uint64_t& count, uint64_t& ns, F&& operation) {
+    span interval(count, ns);
+    return std::forward<F>(operation)();
+}
+inline int step(sqlite3_stmt* statement) {
+    const int result = timed(local.totals.step_calls, local.totals.step_ns,
+                            [&] { return sqlite3_step(statement); });
+    if (local.totals.enabled && result == SQLITE_ROW) add(local.totals.row_returns, 1);
+    return result;
+}
+inline int finalize(sqlite3_stmt* statement) {
+    return timed(local.totals.finalize_calls, local.totals.finalize_ns,
+                 [&] { return sqlite3_finalize(statement); });
+}
+} // namespace lattice_perf_detail
+
+extern "C" void lattice_perf_live_reset(int enabled) {
+    auto& local = lattice_perf_detail::local;
+    if (local.query_depth || local.span_active) { local.totals.faults |= 8; return; }
+    local.totals = {1, enabled ? uint64_t{1} : uint64_t{0}, 0};
+}
+extern "C" struct lattice_perf_live_snapshot lattice_perf_live_read_snapshot(void) {
+    return lattice_perf_detail::local.totals;
+}
+extern "C" int lattice_perf_thread_cpu_ns(uint64_t* out) {
+    if (!out) { lattice_perf_detail::local.totals.faults |= 1; return 0; }
+    return lattice_perf_detail::clock_ns(CLOCK_THREAD_CPUTIME_ID, *out) ? 1 : 0;
+}
