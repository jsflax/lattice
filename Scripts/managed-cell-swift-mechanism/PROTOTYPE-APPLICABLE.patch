+TEST(ManagedCellStatementReuse, ManualFieldSqlAndRawAuthorizerUseFreshPreparation) {
+    database db(":memory:");table(db);auto field=integer(db);
+    field.column_name="i AS different";EXPECT_EQ(field.detach(),-7);EXPECT_EQ(state(db).idle,0u);
+    field.column_name="i";EXPECT_EQ(field.detach(),7);ASSERT_EQ(state(db).idle,1u);
+    auto* raw=db.handle();EXPECT_TRUE(state(db).disabled);EXPECT_EQ(state(db).idle,0u);
+    EXPECT_EQ(sqlite3_next_stmt(raw,nullptr),nullptr);
+    bool allow=true;
+    // An unexpected getter exception must clear the callback before its stack
+    // context dies; database destruction may execute PRAGMA optimize.
+    struct ClearAuthorizer {
+        sqlite3* handle;
+        ~ClearAuthorizer() { sqlite3_set_authorizer(handle,nullptr,nullptr); }
+    } clear_authorizer{raw};
+    ASSERT_EQ(sqlite3_set_authorizer(raw,[](void* context,int action,const char*,const char*,const char*,const char*){
+        return action==SQLITE_READ&&! *static_cast<bool*>(context)?SQLITE_DENY:SQLITE_OK;
+    },&allow),SQLITE_OK);
+    EXPECT_EQ(field.detach(),7);allow=false;EXPECT_THROW(field.detach(),db_error);
+    allow=true;EXPECT_EQ(field.detach(),7);sqlite3_set_authorizer(raw,nullptr,nullptr);
+    EXPECT_EQ(sqlite3_next_stmt(raw,nullptr),nullptr);EXPECT_EQ(state(db).idle,0u);
