diff --git a/Sources/LatticeCore/src/managed_cell_pool.cpp b/Sources/LatticeCore/src/managed_cell_pool.cpp
new file mode 100644
--- /dev/null
+++ b/Sources/LatticeCore/src/managed_cell_pool.cpp
@@ -0,0 +1,127 @@
+#include "managed_cell_pool.hpp"
+#ifdef LATTICE_MANAGED_CELL_STATEMENT_REUSE
+#include <limits>
+#include <utility>
+
+namespace lattice {
+managed_cell_pool::lease::lease(managed_cell_pool* owner, const std::string& sql,
+                                bool eligible) noexcept {
+    if (!owner || !eligible || sql.size() > max_key) return;
+    // A failed key allocation only disables retention for this invocation.
+    try { key_ = sql; } catch (...) { return; }
+    if (key_.capacity() > max_key) return;
+    std::string discarded_key;
+    std::lock_guard<std::mutex> lock(owner->mutex_);
+    if (owner->state_.disabled || owner->state_.suspensions) return;
+    owner_ = owner;
+    generation_ = owner->generation_;
+    retain_ = true;
+    ++owner->state_.active;
+    for (auto& slot : owner->slots_) {
+        if (slot.statement && slot.key == key_) {
+            statement = std::exchange(slot.statement, nullptr);
+            owner->state_.retained_bytes -= slot.bytes;
+            slot.bytes = 0;
+            // Empty the now-unused key without freeing it under the pool lock.
+            key_.swap(slot.key);
+            discarded_key.swap(slot.key);
+            --owner->state_.idle;
+            ++owner->state_.hits;
+            break;
+        }
+    }
+}
+managed_cell_pool::lease::~lease() noexcept { finish(false); }
+void managed_cell_pool::lease::prepared() noexcept {
+    if (owner_) { std::lock_guard<std::mutex> lock(owner_->mutex_); ++owner_->state_.prepares; }
+}
+void managed_cell_pool::lease::finish(bool completed) noexcept {
+    if (owner_) owner_->release(*this, completed);
+    else if (statement) sqlite3_finalize(std::exchange(statement, nullptr));
+}
+managed_cell_pool::managed_cell_pool() noexcept { state_.retained_bytes = sizeof(*this); }
+managed_cell_pool::~managed_cell_pool() noexcept { disable(); }
+void managed_cell_pool::close_admission() noexcept {
+    // Only bounded bookkeeping; never acquire SQLite or wait for a lease.
+    std::lock_guard<std::mutex> lock(mutex_); state_.disabled = true;
+}
+
+void managed_cell_pool::invalidate(bool suspend, bool disable) noexcept {
+    std::array<slot, capacity> retired;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (generation_ == std::numeric_limits<uint64_t>::max()) state_.disabled = true;
+        else ++generation_;
+        if (disable) state_.disabled = true;
+        if (suspend) {
+            if (state_.suspensions == std::numeric_limits<size_t>::max()) state_.disabled = true;
+            else ++state_.suspensions;
+        }
+        retired.swap(slots_);
+        state_.retired += state_.idle;
+        state_.idle = 0; state_.retained_bytes = sizeof(*this);
+    }
+    // SQLite may run extension cleanup here. No pool/publication lock is held.
+    for (auto& item : retired) if (item.statement) sqlite3_finalize(item.statement);
+}
+void managed_cell_pool::suspend() noexcept { invalidate(true, false); }
+void managed_cell_pool::resume() noexcept {
+    // Retire nested ephemeral-era candidates before reopening admission.
+    invalidate(false, false);
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (state_.suspensions) --state_.suspensions;
+}
+void managed_cell_pool::disable() noexcept { invalidate(false, true); }
+managed_cell_pool::observation managed_cell_pool::inspect() const {
+    std::lock_guard<std::mutex> lock(mutex_); return state_;
+}
+void managed_cell_pool::set_before_step(void (*hook)(void*), void* context) noexcept {
+    std::lock_guard<std::mutex> lock(mutex_);
+    before_step_ = hook; before_step_context_ = context;
+}
+void managed_cell_pool::before_step() const {
+    void (*hook)(void*); void* context;
+    { std::lock_guard<std::mutex> lock(mutex_); hook = before_step_; context = before_step_context_; }
+    if (hook) hook(context);
+}
+void managed_cell_pool::fail_next_reset_for_test() noexcept {
+    std::lock_guard<std::mutex> lock(mutex_); fail_reset_ = true;
+}
+void managed_cell_pool::release(lease& lease, bool completed) noexcept {
+    auto* statement = std::exchange(lease.statement, nullptr);
+    bool reset_failed = false;
+    if (statement && completed && lease.retain_) {
+        // Original successful-DONE path ignores finalize's return. A reset-only
+        // failure retires the VM without changing that successful return value.
+        const int reset = sqlite3_reset(statement);
+        const int clear = sqlite3_clear_bindings(statement);
+        reset_failed = reset != SQLITE_OK || clear != SQLITE_OK;
+        if (reset_failed) completed = false;
+    }
+    const int memory = statement ? sqlite3_stmt_status(statement, SQLITE_STMTSTATUS_MEMUSED, 0) : 0;
+    const size_t bytes = sizeof(slot) + lease.key_.capacity() + 1 + (memory > 0 ? size_t(memory) : max_bytes);
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (fail_reset_ && completed && statement) {
+            fail_reset_ = false; reset_failed = true; completed = false;
+        }
+        if (reset_failed) ++state_.reset_failures;
+        if (statement && completed && lease.retain_ && !state_.disabled && !state_.suspensions &&
+            generation_ == lease.generation_ && bytes <= max_bytes && state_.retained_bytes <= max_bytes - bytes) {
+            bool duplicate = false;
+            for (const auto& slot : slots_) if (slot.statement && slot.key == lease.key_) duplicate = true;
+            if (!duplicate) for (auto& slot : slots_) if (!slot.statement) {
+                slot.statement = std::exchange(statement, nullptr);
+                slot.key.swap(lease.key_); slot.bytes = bytes;
+                ++state_.idle; state_.retained_bytes += bytes;
+                break;
+            }
+        }
+        if (statement) ++state_.retired;
+        --state_.active;
+        lease.owner_ = nullptr;
+    }
+    if (statement) sqlite3_finalize(statement);
+}
+} // namespace lattice
+#endif
diff --git a/Sources/LatticeCore/src/managed_cell_pool.hpp b/Sources/LatticeCore/src/managed_cell_pool.hpp
new file mode 100644
--- /dev/null
+++ b/Sources/LatticeCore/src/managed_cell_pool.hpp
@@ -0,0 +1,62 @@
+#pragma once
+
+#ifdef LATTICE_MANAGED_CELL_STATEMENT_REUSE
+#include <sqlite3.h>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace lattice {
+// Private diagnostic implementation. No values, transaction, or connection
+// ownership are stored here. The database must outlive every synchronous lease.
+class managed_cell_pool {
+public:
+    static constexpr size_t capacity = 16, max_key = 4096, max_bytes = 256 * 1024;
+    struct observation {
+        size_t idle = 0, retained_bytes = 0, active = 0, suspensions = 0;
+        uint64_t hits = 0, prepares = 0, retired = 0, reset_failures = 0;
+        bool disabled = false;
+    };
+    class lease {
+        friend class managed_cell_pool;
+        managed_cell_pool* owner_ = nullptr;
+        std::string key_;
+        uint64_t generation_ = 0;
+        bool retain_ = false;
+    public:
+        sqlite3_stmt* statement = nullptr;
+        lease(managed_cell_pool* owner, const std::string& sql, bool eligible) noexcept;
+        ~lease() noexcept;
+        lease(const lease&) = delete;
+        lease& operator=(const lease&) = delete;
+        void prepared() noexcept;
+        void finish(bool completed) noexcept;
+    };
+    managed_cell_pool() noexcept;
+    ~managed_cell_pool() noexcept;
+    void close_admission() noexcept;
+    void suspend() noexcept;
+    void resume() noexcept;
+    void disable() noexcept;
+    observation inspect() const;
+    // Private diagnostic seams. Called with no pool lock held; never installed
+    // by a production caller. Caller supplies a live, synchronized context.
+    void set_before_step(void (*hook)(void*), void* context) noexcept;
+    void before_step() const;
+    void fail_next_reset_for_test() noexcept;
+private:
+    struct slot { sqlite3_stmt* statement = nullptr; std::string key; size_t bytes = 0; };
+    mutable std::mutex mutex_;
+    std::array<slot, capacity> slots_;
+    observation state_;
+    uint64_t generation_ = 0;
+    bool fail_reset_ = false;
+    void (*before_step_)(void*) = nullptr;
+    void* before_step_context_ = nullptr;
+    void invalidate(bool suspend, bool disable) noexcept;
+    void release(lease&, bool completed) noexcept;
+};
+} // namespace lattice
+#endif
