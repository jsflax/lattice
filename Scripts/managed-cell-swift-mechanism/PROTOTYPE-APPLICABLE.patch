+    auto control=std::make_shared<database_read_control>();control->deadline=std::chrono::steady_clock::now()+2s;
+    sqlite3_stmt* statement=nullptr;
+    struct UnwindCapture {};
+    bool entered=false,unwound=false;
+    try {
+        database_projection_capture capture(db,control,statement);
+        entered=true;
+        EXPECT_EQ(state(db).idle,0u);EXPECT_EQ(state(db).suspensions,1u);
+        EXPECT_THROW(field.detach(),db_error);EXPECT_TRUE(capture.denied());
+        throw UnwindCapture{};
+    } catch(const UnwindCapture&) { unwound=true; }
+    EXPECT_TRUE(entered);EXPECT_TRUE(unwound);
+    EXPECT_EQ(statement,nullptr);EXPECT_EQ(state(db).suspensions,0u);
+    EXPECT_NO_THROW((void)field.detach());EXPECT_EQ(state(db).idle,1u);
+}
