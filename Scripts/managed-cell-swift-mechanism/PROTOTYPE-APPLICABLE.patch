+TEST(ManagedCellStatementReuse, SixHundredLiveReadsExecuteWithSixPrepares) {
+    database db(":memory:"); table(db); ASSERT_NE(managed_cell_pool_test_access::pool(db),nullptr);
+    auto i=integer(db),j=integer(db,"Cell","j"),k=integer(db,"Cell","k");
+    managed<double> r; r.assign(&db,nullptr,"Cell","r",1);
+    managed<std::string> t,u; t.assign(&db,nullptr,"Cell","t",1);u.assign(&db,nullptr,"Cell","u",1);
+    const auto before=database::thread_statement_count();
+    for(int n=0;n<100;++n) {
+        const int64_t id=n%2+1;i.row_id=j.row_id=k.row_id=r.row_id=t.row_id=u.row_id=id;
+        EXPECT_EQ(i.detach(),id==1?7:70);EXPECT_EQ(j.detach(),id==1?11:110);EXPECT_EQ(k.detach(),id==1?13:130);
+        EXPECT_DOUBLE_EQ(r.detach(),id==1?2.5:25.5);EXPECT_EQ(t.detach(),id==1?"first":"second");EXPECT_EQ(u.detach(),id==1?"tail":"end");
+    }
+    EXPECT_EQ(database::thread_statement_count()-before,600u);
+    const auto snapshot=state(db);EXPECT_EQ(snapshot.prepares,6u);EXPECT_EQ(snapshot.hits,594u);
+    EXPECT_EQ(snapshot.idle,6u);EXPECT_EQ(snapshot.active,0u);EXPECT_LE(snapshot.retained_bytes,managed_cell_pool::max_bytes);
+}
