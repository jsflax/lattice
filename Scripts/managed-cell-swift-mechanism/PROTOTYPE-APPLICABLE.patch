+TEST(ManagedCellStatementReuse, ConcurrentSameSqlNeverWaitsForPausedLease) {
+    database db(":memory:");table(db);auto field=integer(db);EXPECT_EQ(field.detach(),7);Gate gate;
+    managed_cell_pool_test_access::pool(db)->set_before_step(Gate::pause_first,&gate);
+    std::exception_ptr worker_failure,main_failure;int64_t first=0;
+    std::thread worker([&]{try{first=field.detach();}catch(...){worker_failure=std::current_exception();}});
+    const bool entered=gate.wait();
+    // Always release/join even when an expectation fails; the gate itself is bounded.
+    int64_t second=0;try{if(entered)second=field.detach();}catch(...){main_failure=std::current_exception();}
+    gate.release();worker.join();managed_cell_pool_test_access::pool(db)->set_before_step(nullptr,nullptr);
+    EXPECT_TRUE(entered);EXPECT_FALSE(worker_failure);EXPECT_FALSE(main_failure);EXPECT_EQ(first,7);EXPECT_EQ(second,7);
+    EXPECT_EQ(state(db).prepares,2u);EXPECT_EQ(state(db).active,0u);EXPECT_EQ(state(db).idle,1u);
+}
