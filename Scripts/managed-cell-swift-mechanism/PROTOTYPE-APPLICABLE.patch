+        std::exception_ptr failure;int64_t answer=0;
+        std::thread worker([&]{try{answer=field.detach();}catch(...){failure=std::current_exception();}});
+        const bool entered=gate.wait();if(escape)(void)db.handle();else db.close();
+        gate.release();worker.join();managed_cell_pool_test_access::pool(db)->set_before_step(nullptr,nullptr);
+        EXPECT_TRUE(entered);EXPECT_FALSE(failure);EXPECT_EQ(answer,7);
+        EXPECT_TRUE(state(db).disabled);EXPECT_EQ(state(db).active,0u);EXPECT_EQ(state(db).idle,0u);
+        EXPECT_EQ(field.detach(),escape?7:-7);
+    }
