+namespace lattice {
+struct managed_cell_pool_test_access {
+    static managed_cell_pool* pool(database& db) { return db.managed_cell_pool_; }
+    static sqlite3* trusted(database& db) { return db.internal_handle(); }
+    static void policy(database& db, const std::function<void(sqlite3*)>& body) {
+        database::managed_cell_policy_scope scope(db); body(db.internal_handle());
+    }
+};
+}
+namespace {
+using namespace lattice;
+using namespace std::chrono_literals;
+void table(database& db) {
+    db.execute("CREATE TABLE Cell(id INTEGER PRIMARY KEY,i INTEGER,r REAL,t TEXT,j INTEGER,k INTEGER,u TEXT)");
+    db.execute("INSERT INTO Cell VALUES(1,7,2.5,'first',11,13,'tail'),(2,70,25.5,'second',110,130,'end')");
+}
+managed<int64_t> integer(database& db, const std::string& model="Cell", const std::string& column="i", int64_t id=1) {
+    managed<int64_t> field(int64_t(-7)); field.assign(&db,nullptr,model,column,id); return field;
+}
+auto state(database& db) { return managed_cell_pool_test_access::pool(db)->inspect(); }
+struct Gate {
+    std::mutex mutex; std::condition_variable condition; bool entered=false,open=false;
+    std::atomic<unsigned> calls{0};
+    static void pause_first(void* context) {
+        auto& gate=*static_cast<Gate*>(context);
+        if (gate.calls.fetch_add(1)!=0) return;
+        std::unique_lock<std::mutex> lock(gate.mutex); gate.entered=true; gate.condition.notify_all();
+        if (!gate.condition.wait_for(lock,2s,[&]{return gate.open;})) throw std::runtime_error("lease gate expired");
+    }
+    bool wait() { std::unique_lock<std::mutex> lock(mutex);return condition.wait_for(lock,1s,[&]{return entered;}); }
+    void release() { std::lock_guard<std::mutex> lock(mutex);open=true;condition.notify_all(); }
+};
+}
