+    EXPECT_EQ(state(owner).prepares,1u);EXPECT_EQ(state(owner).hits,1u);
+    owner.begin_transaction();owner.execute("UPDATE Cell SET i=12 WHERE id=1");EXPECT_EQ(field.detach(),12);
+    owner.rollback();EXPECT_EQ(field.detach(),9);
+    writer.execute("UPDATE Cell SET i=NULL WHERE id=1");EXPECT_EQ(field.detach(),-7);
+    writer.execute("UPDATE Cell SET i='wrong' WHERE id=1");EXPECT_EQ(field.detach(),-7);
